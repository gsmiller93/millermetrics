# Copy this file to `.env` and fill in real values for local runs.
# `.env` is git-ignored — do NOT commit it.
#
# Grab ESPN_S2 and SWID from Chrome DevTools while logged in to ESPN Fantasy:
#   1. Open https://fantasy.espn.com/ and sign in
#   2. F12 -> Application tab -> Storage -> Cookies -> https://fantasy.espn.com
#   3. Copy the values for `espn_s2` and `SWID` exactly as shown
#
# In GitHub Actions these are read from repository Secrets, not from .env.

ESPN_S2=paste_espn_s2_cookie_value_here
SWID={paste-SWID-cookie-value-here-including-curly-braces}

# League IDs are public and live in scripts/update.py (LEAGUES list).
# No secret needed for them.
